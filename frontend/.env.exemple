# Copie ce fichier en `.env.local` (ignore par git) si l'API n'est pas sur
# le port par defaut.
#
# Sans ce fichier, le front appelle http://127.0.0.1:8000/api — le
# `runserver` local. Au deploiement sur le VPS, renseigner l'adresse
# publique de l'API, et penser a ajouter l'origine du site dans
# CORS_ORIGINES cote backend (voir backend/.env.exemple) : les deux vont
# toujours par paire.
VITE_API_URL=http://127.0.0.1:8000/api
